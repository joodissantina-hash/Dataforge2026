{
  "name": "jood",
  "version": "1.0.0",
  "description": "Root package for running both frontend and backend concurrently.",
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend-app",
    "dev:backend": "cd backend && .\\venv\\Scripts\\activate && uvicorn server:app --port 8001",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
